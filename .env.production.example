# Public DNS records must point to the VPS before Caddy starts.
SITE_DOMAIN=example.com
ADMIN_DOMAIN=cms.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com

# Use URL-safe values such as: openssl rand -hex 32
POSTGRES_DB=parto_cms
POSTGRES_USER=parto
POSTGRES_PASSWORD=replace-with-a-random-hex-value

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Used only when you explicitly run the one-time production seed command.
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-admin-password
DEFAULT_EDITOR_EMAIL=editor@example.com
DEFAULT_EDITOR_PASSWORD=replace-with-a-strong-editor-password
