# ============================================
# Parto CMS — Environment Variables
# ============================================
# Copy to .env and fill in values

# --- PostgreSQL ---
DATABASE_URL=postgresql://parto:parto_secret@localhost:5432/parto_cms?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- MinIO (S3-compatible storage) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=parto-media
S3_REGION=us-east-1

# --- JWT Authentication ---
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string
JWT_REFRESH_EXPIRES_IN=7d

# --- API ---
# NOTE: 3001 is used by parto-ems. The CMS API defaults to 3006 (see apps/api/src/main.ts).
API_PORT=3006
API_URL=http://localhost:3006

# --- Admin Dashboard ---
NEXT_PUBLIC_API_URL=http://localhost:3006/api/v1
# Origin allowed by the API's CORS policy
ADMIN_URL=http://localhost:3003


# --- AI Integration (optional) ---
AI_PROVIDER=openai
AI_API_KEY=

# --- SMTP (for notifications, optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@parto.ir

# --- Default Admin User ---
DEFAULT_ADMIN_EMAIL=admin@parto.ir
DEFAULT_ADMIN_PASSWORD=admin123