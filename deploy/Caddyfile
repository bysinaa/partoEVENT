{
  email {$ACME_EMAIL}
}

(security_headers) {
  header {
    -Server
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options SAMEORIGIN
  }
}

{$SITE_DOMAIN} {
  import security_headers
  encode zstd gzip
  reverse_proxy website:3000
}

{$ADMIN_DOMAIN} {
  import security_headers
  encode zstd gzip
  reverse_proxy admin:3003
}

{$API_DOMAIN} {
  import security_headers
  encode zstd gzip
  reverse_proxy api:3006
}
